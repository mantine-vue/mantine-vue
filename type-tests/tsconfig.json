{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@mantine-vue/*": ["../packages/@mantine-vue/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "./PublicApi.vue",
    "./public-api.ts",
    "./Polymorphic.vue",
    "./polymorphic.ts",
    "./polymorphic-components.ts",
    "./PolymorphicComponents.vue"
  ]
}
